# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# Amazon affiliate tag used in generated amazon.com.br links
AMAZON_AFFILIATE_TAG=your-amazon-tag-here

# Mercado Livre affiliate data
# Login is currently manual via browser, but these fields are kept for future use/reference
ML_AFFILIATE_EMAIL=your-email@example.com
ML_AFFILIATE_PASSWORD=your-password-here

# Optional proxy, only if you want/need to route ML affiliate access through one
ML_PROXY=http://your-proxy-here:port

# WhatsApp configuration
# Used as the default group for scan_deals.py and send_to_whatsapp.py
# Backend used by the sender: playwright or baileys.
WHATSAPP_SENDER_BACKEND=playwright
# Pause between consecutive WhatsApp sends. Leave empty for backend default:
# baileys=30 seconds, playwright=0 seconds.
WHATSAPP_SEND_INTERVAL_SECONDS=
# Local HTTP gateway used when WHATSAPP_SENDER_BACKEND=baileys.
BAILEYS_GATEWAY_URL=http://127.0.0.1:3015
# Baileys gateway process configuration.
BAILEYS_PORT=3015
BAILEYS_AUTH_DIR=.agents/skills/price-alert-skill/data/baileys_auth
BAILEYS_LOG_LEVEL=info
# Optional absolute paths for cron/systemd when node or npm are not in PATH.
BAILEYS_NODE_BIN=
BAILEYS_NPM_BIN=
WHATSAPP_GROUP=your-whatsapp-group-name-here
# Required by WHATSAPP_SENDER_BACKEND=baileys; discover it via GET /groups.
WHATSAPP_GROUP_JID=your-whatsapp-group-jid-here@g.us

# Runtime selection for OS-specific adapters: auto, windows, or linux
# auto detects Windows vs Linux/WSL from the current host
PRICE_ALERT_RUNTIME=auto

# Product scan profile used by run_scan scripts: tech or beauty
PRICE_ALERT_SCAN_PROFILE=beauty
# Optional comma-separated categories inside the selected profile, for controlled rollouts
# Example: beleza_perfumes,beleza_skincare
PRICE_ALERT_SCAN_CATEGORIES=
# Optional rotating category batch size when PRICE_ALERT_SCAN_CATEGORIES is empty.
# Leave empty to auto-batch beauty as 2 categories per run and keep other profiles full-profile.
PRICE_ALERT_SCAN_CATEGORY_BATCH_SIZE=
# Product profile consumed by the sender. Keep tech until the beauty rollout is ready.
PRICE_ALERT_SEND_PROFILE=beauty

# Optional: force a specific Chrome executable for WhatsApp Web automation
# Leave empty to auto-detect Chrome on Windows and fall back to Playwright Chromium
WHATSAPP_CHROME_PATH=

# Optional: force a specific persistent Chrome profile directory for WhatsApp Web
# On Windows the default will use %LOCALAPPDATA%\price-alert-skill\whatsapp_chrome_profile
WHATSAPP_PROFILE_DIR=
WHATSAPP_HEADLESS_TIMEOUT_SECONDS=300
# Optional: override the Chrome user-agent used only for headless WhatsApp Web
WHATSAPP_USER_AGENT=
