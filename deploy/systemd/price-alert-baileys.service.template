[Unit]
Description=Price Alert Baileys gateway
After=network-online.target
Wants=network-online.target
PartOf=price-alert-runtime.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__SKILL_ROOT__
Environment=TZ=__TIMEZONE__
ExecStart=__SKILL_ROOT__/run_baileys_gateway.sh
Restart=always
RestartSec=10

[Install]
WantedBy=price-alert-runtime.target
